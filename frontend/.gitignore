# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# โฟลเดอร์พัก API ระหว่าง build ไฟล์นิ่ง ปกติจะถูกย้ายกลับเสมอ
# เหลืออยู่แปลว่า build ถูกขัดจังหวะ
/.api-parked/

# ผลจาก Playwright MCP ตอนทดสอบ
/.playwright-mcp/
